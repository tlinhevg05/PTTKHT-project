# Docker image built and published by your team
APP_IMAGE=example/apartment-web-app:latest

# PostgreSQL connection owned by your team
DB_URL=jdbc:postgresql://db.example.com:5432/apartment
DB_USERNAME=apartment_app
DB_PASSWORD=replace-with-your-own-database-password

# Optional SMTP account
MAIL_USERNAME=
MAIL_PASSWORD=

# Grafana administrator account
GRAFANA_PASSWORD=replace-with-a-strong-password
